# =============================================================================
# Typhoon API Server
# Multi-stage: install deps → runtime with full workspace source
# Bun runs TypeScript directly — no build step needed
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Install dependencies
# ---------------------------------------------------------------------------
FROM oven/bun:1.3.11-alpine AS deps

WORKDIR /app

# Copy only files needed for dependency resolution (maximises layer cache)
COPY package.json bun.lock ./
COPY apps/server/package.json apps/server/
COPY apps/desk/package.json apps/desk/
COPY apps/admin/package.json apps/admin/
COPY apps/widget/package.json apps/widget/
COPY packages/agents/package.json packages/agents/
COPY packages/ai/package.json packages/ai/
COPY packages/chat/package.json packages/chat/
COPY packages/config/package.json packages/config/
COPY packages/db/package.json packages/db/
COPY packages/ingestion/package.json packages/ingestion/
COPY packages/logger/package.json packages/logger/
COPY packages/pg/package.json packages/pg/
COPY packages/storage/package.json packages/storage/
COPY packages/types/package.json packages/types/
COPY packages/ui/package.json packages/ui/

RUN bun install --frozen-lockfile

# ---------------------------------------------------------------------------
# Stage 2: Runtime
# ---------------------------------------------------------------------------
FROM oven/bun:1.3.11-alpine

WORKDIR /app

# Copy installed node_modules (includes workspace symlinks)
COPY --from=deps /app/node_modules ./node_modules

# Copy workspace source — Bun resolves workspace:* via symlinks to raw .ts
COPY package.json bun.lock turbo.json tsconfig.json ./
COPY apps/server/ apps/server/
COPY packages/ packages/

EXPOSE 5172

HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD wget -qO/dev/null http://127.0.0.1:5172/api/v1/auth/ok || exit 1

CMD ["bun", "run", "apps/server/src/index.ts"]
