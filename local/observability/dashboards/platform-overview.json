    {
      "type": "bargauge",
      "title": "Tool calls by tool, top 10",
      "description": "The ten tools called most often through the gateway. Counted over the time range selected at the top right.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(topk(10, sum by (server, resource) (clamp_min(agentgateway_mcp_requests_total{method=\"tools/call\"} - agentgateway_mcp_requests_total{method=\"tools/call\"} offset $__range, 0) or agentgateway_mcp_requests_total{method=\"tools/call\"})))",
          "legendFormat": "{{server}}: {{resource}}",
