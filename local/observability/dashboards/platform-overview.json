    {
      "type": "timeseries",
      "title": "Requests refused, per minute",
      "description": "401: the caller presented no valid sign-in. 403: the caller is signed in but may not use this route (role or model). 400 on an MCP route: the caller asked for a tool that is not offered to their role; a malformed MCP request is counted here too.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (clamp_min(agentgateway_requests_total{status=~\"401|403\"} - agentgateway_requests_total{status=~\"401|403\"} offset $__interval, 0) or agentgateway_requests_total{status=~\"401|403\"})",
          "legendFormat": "{{status}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(clamp_min(agentgateway_requests_total{status=\"400\", reason=\"MCP\"} - agentgateway_requests_total{status=\"400\", reason=\"MCP\"} offset $__interval, 0) or agentgateway_requests_total{status=\"400\", reason=\"MCP\"})",
          "legendFormat": "400",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
