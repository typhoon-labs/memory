    {
      "type": "stat",
      "title": "Telemetry lost",
      "description": "Trace spans and log records the collector could not accept or could not deliver. 0 means the numbers on this page are complete. Counted over the time range selected at the top right.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round((sum(increase(otelcol_receiver_refused_spans_total[$__range])) or vector(0)) + (sum(increase(otelcol_receiver_refused_log_records_total[$__range])) or vector(0)) + (sum(increase(otelcol_exporter_send_failed_spans_total[$__range])) or vector(0)) + (sum(increase(otelcol_exporter_send_failed_log_records_total[$__range])) or vector(0)))",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 5
    },
    {
      "type": "bargauge",
      "title": "Requests by route, top 10",
      "description": "The ten gateway routes used most: the model route, each tool server, each agent. 'unknown' is a request that matched no route. Counted over the time range selected at the top right.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(topk(10, sum by (route) (clamp_min(agentgateway_requests_total - agentgateway_requests_total offset $__range, 0) or agentgateway_requests_total)))",
          "legendFormat": "{{route}}",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "text",
        "namePlacement": "left",
        "showUnfilled": true,
        "minVizHeight": 14,
        "minVizWidth": 8,
        "maxVizHeight": 300,
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Requests per second, by kind",
      "description": "Gateway traffic over time: model calls, tool calls (MCP), agent-to-agent calls (A2A) and other HTTP.",
