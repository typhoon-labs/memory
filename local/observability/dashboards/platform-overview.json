          },
          "expr": "sum(clamp_min(agentgateway_gen_ai_client_token_usage_sum{gen_ai_token_type=~\"input|output\"} - agentgateway_gen_ai_client_token_usage_sum{gen_ai_token_type=~\"input|output\"} offset $__range, 0) or agentgateway_gen_ai_client_token_usage_sum{gen_ai_token_type=~\"input|output\"}) or vector(0)",
          "legendFormat": "",
