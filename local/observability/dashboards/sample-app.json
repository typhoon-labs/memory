        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": false
        }
      },
      "interval": "5s",
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Searches with no result",
      "description": "Share of answered searches that matched nothing, over one minute. Read from the Sample App's own /metrics, every 5 seconds. Empty until the Sample App is deployed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(search_zero_results_total[1m])) / sum(rate(http_requests_total{service_name=\"search-service\", route=\"/search\"}[1m]))",
          "legendFormat": "no result",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
