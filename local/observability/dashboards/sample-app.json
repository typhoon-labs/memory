{
  "uid": "sample-app",
  "title": "Sample App",
  "description": "Health of the Sample App as its users see it: web, search-service and registration-service. The search objective is 99.5% of searches answered without a server error.",
  "tags": [
    "demo",
    "sample-app"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Search alert firing",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "#d03b3b",
        "expr": "ALERTS{alertname=\"SearchErrorRatioHigh\", alertstate=\"firing\"}",
        "step": "5s",
        "titleFormat": "SearchErrorRatioHigh is firing",
        "textFormat": "search-service {{version}}",
        "tagKeys": "service"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Search success, last 30 seconds",
      "description": "Share of searches answered without a server error. Objective: 99.5%. Green at or above the objective, red below. Read from the Sample App's own /metrics, every 5 seconds. Empty until the Sample App is deployed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(rate(http_requests_total{service_name=\"search-service\", route=\"/search\", status=~\"5..\"}[30s])) / sum(rate(http_requests_total{service_name=\"search-service\", route=\"/search\"}[30s])))",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "mappings": [],
          "noValue": "waiting for Sample App metrics",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Error budget burn, last minute",
      "description": "How fast failed searches use up the error budget: 1 means exactly as fast as a 99.5% objective allows, 200 means every search fails. Green below 1, yellow from 1, red from 10. Read from the Sample App's own /metrics, every 5 seconds. Empty until the Sample App is deployed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_requests_total{service_name=\"search-service\", route=\"/search\", status=~\"5..\"}[1m])) / sum(rate(http_requests_total{service_name=\"search-service\", route=\"/search\"}[1m]))) / (1 - 0.995)",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "mappings": [],
          "noValue": "waiting for Sample App metrics",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Error budget left, last hour",
      "description": "The share of the last hour's error budget that is still unused: 100% when no search failed, 0% when more than 0.5% of the hour's searches failed. Green from 50%, yellow below, red at 0%. Read from the Sample App's own /metrics, every 5 seconds. Empty until the Sample App is deployed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(1 - ((sum(increase(http_requests_total{service_name=\"search-service\", route=\"/search\", status=~\"5..\"}[1h])) / sum(increase(http_requests_total{service_name=\"search-service\", route=\"/search\"}[1h]))) / (1 - 0.995)), 0)",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "mappings": [],
          "noValue": "waiting for Sample App metrics",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 0.0001
              },
              {
                "color": "#0ca30c",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "No-result searches, 5 minutes",
      "description": "Share of answered searches that matched nothing in the catalogue. About 5% with the demo's traffic generator. Read from the Sample App's own /metrics, every 5 seconds. Empty until the Sample App is deployed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 15,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(search_zero_results_total[5m])) / sum(rate(http_requests_total{service_name=\"search-service\", route=\"/search\"}[5m]))",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "mappings": [],
          "noValue": "waiting for Sample App metrics",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "search-service version",
      "description": "The version that is running now, from app_info. Two values while a release is replacing the pod. Read from the Sample App's own /metrics, every 5 seconds. Empty until the Sample App is deployed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (version) (app_info{service_name=\"search-service\"})",
          "legendFormat": "{{version}}",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "noValue": "waiting for Sample App metrics",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "description": "Requests handled by each service, averaged over 30 seconds. Read from the Sample App's own /metrics, every 5 seconds. Empty until the Sample App is deployed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(http_requests_total[30s]))",
          "legendFormat": "{{service_name}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "barAlignment": 0,
            "barWidthFactor": 0.7,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "lineInterpolation": "linear",
            "gradientMode": "none",
            "axisBorderShow": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "web"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "search-service"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "registration-service"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": false
        }
      },
      "interval": "5s",
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Requests answered with a server error",
      "description": "Share of each service's requests that ended in HTTP 5xx, over 30 seconds. The dashed line is 5%: above it for 10 seconds on search-service, the alert fires. Read from the Sample App's own /metrics, every 5 seconds. Empty until the Sample App is deployed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(http_requests_total{status=~\"5..\"}[30s])) / sum by (service_name) (rate(http_requests_total[30s]))",
          "legendFormat": "{{service_name}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "barAlignment": 0,
            "barWidthFactor": 0.7,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "lineInterpolation": "linear",
            "gradientMode": "none",
            "axisBorderShow": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 0.05
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "web"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "search-service"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "registration-service"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": false
        }
      },
      "interval": "5s",
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Response time, 95th percentile",
      "description": "95 of 100 requests were answered at least this fast, over one minute. Read from the Sample App's own /metrics, every 5 seconds. Empty until the Sample App is deployed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{service_name}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "barAlignment": 0,
            "barWidthFactor": 0.7,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "lineInterpolation": "linear",
            "gradientMode": "none",
            "axisBorderShow": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "web"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "search-service"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "registration-service"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": false
        }
      },
      "interval": "5s",
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Search success against the 99.5% objective",
      "description": "Share of searches answered without a server error, over one minute. The dashed line is the objective. Read from the Sample App's own /metrics, every 5 seconds. Empty until the Sample App is deployed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(rate(http_requests_total{service_name=\"search-service\", route=\"/search\", status=~\"5..\"}[1m])) / sum(rate(http_requests_total{service_name=\"search-service\", route=\"/search\"}[1m])))",
          "legendFormat": "search success",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "barAlignment": 0,
            "barWidthFactor": 0.7,
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "lineInterpolation": "linear",
            "gradientMode": "none",
            "axisBorderShow": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0.995
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "search success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
