# =============================================================================
# Typhoon — Environment Variables
# =============================================================================

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://typhoon:typhoon@postgres:5432/typhoon

# Redis
REDIS_URL=redis://redis:6379

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=typhoon-documents

# Sync target: Typhoon Documents (per-target env var overrides)
TYPHOON_DOCS_BUCKET=typhoon-documents
TYPHOON_DOCS_PREFIX=
TYPHOON_DOCS_CRON=0 */6 * * *

# LLM Gateway (OpenAI-compatible endpoint — Bifrost routes to Bedrock in prod)
LLM_BASE_URL=http://bifrost:8787/v1
LLM_API_KEY=changeme
LLM_CHAT_MODEL=bedrock/us.anthropic.claude-sonnet-4-6
LLM_TITLE_MODEL=bedrock/us.anthropic.claude-haiku-4-5
LLM_RERANKER_MODEL=bedrock/us.anthropic.claude-haiku-4-5
LLM_EXTRACTION_MODEL=bedrock/us.anthropic.claude-haiku-4-5
LLM_GUARDRAIL_MODEL=bedrock/us.anthropic.claude-haiku-4-5

# Guardrails (disable if handled by provider, e.g. AWS Bedrock Guardrails)
# Bedrock provides prompt injection, moderation, and PII detection natively.
# Only system prompt scrubbing has no Bedrock equivalent.
GUARDRAIL_PROMPT_INJECTION=false
GUARDRAIL_MODERATION=false
GUARDRAIL_PII_DETECTION=false
GUARDRAIL_SYSTEM_PROMPT_SCRUBBING=true

# Embeddings (Amazon Titan via Bedrock/Bifrost)
EMBEDDING_BASE_URL=http://bifrost:8787/v1
EMBEDDING_API_KEY=bedrock
EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=1024

# AWS (used by Bifrost to call Bedrock — not needed if using local Ollama only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Provider API keys (passed to Bifrost gateway, not used by the app directly)
ANTHROPIC_API_KEY=

# Auth
# Generate AUTH_SECRET with: openssl rand -hex 32
AUTH_SECRET=change-me-in-production
AUTH_URL=http://localhost:5172
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://host.docker.internal:5173,http://host.docker.internal:5174

# OIDC (optional — Dex for local dev, Okta for production)
OIDC_ISSUER_URL=http://localhost:5556/dex
OIDC_CLIENT_ID=typhoon
OIDC_CLIENT_SECRET=typhoon-secret

# Server
PORT=5172
HOST=0.0.0.0

LOG_LEVEL=info
