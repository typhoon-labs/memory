# =============================================================================
# Typhoon — Environment Variables
# =============================================================================

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://typhoon:typhoon@postgres:5432/typhoon

# Redis
REDIS_URL=redis://redis:6379

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=typhoon-documents

# Sync target: Typhoon Documents (per-target env var overrides)
TYPHOON_DOCS_BUCKET=typhoon-documents
TYPHOON_DOCS_PREFIX=
TYPHOON_DOCS_CRON="0 */6 * * *"

# LLM Gateway (OpenAI-compatible endpoint — Bifrost routes to Bedrock in prod)
LLM_BASE_URL=http://bifrost:8787/v1
LLM_API_KEY=changeme
LLM_CHAT_MODEL=bedrock/us.anthropic.claude-sonnet-4-6
LLM_TITLE_MODEL=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_RERANKER_MODEL=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_EXTRACTION_MODEL=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_GUARDRAIL_MODEL=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_KNOWLEDGE_MODEL=bedrock/us.anthropic.claude-sonnet-4-6
LLM_CITATION_MODEL=bedrock/us.anthropic.claude-sonnet-4-6
LLM_SCORING_MODEL=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_SCORING_MODEL_OPTIONS=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0,bedrock/us.anthropic.claude-sonnet-4-6

# Guardrails (disable if handled by provider, e.g. AWS Bedrock Guardrails)
# Bedrock provides prompt injection, moderation, and PII detection natively.
# Only system prompt scrubbing has no Bedrock equivalent.
GUARDRAIL_PROMPT_INJECTION=false
GUARDRAIL_MODERATION=false
GUARDRAIL_PII_DETECTION=false
GUARDRAIL_SYSTEM_PROMPT_SCRUBBING=true

# Embeddings
# Production: Amazon Titan V2 via Bedrock/Bifrost
EMBEDDING_BASE_URL=http://bifrost:8787/v1
EMBEDDING_API_KEY=bedrock
EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_CHARS=50000
EMBEDDING_MAX_TOKENS=8192
EMBEDDING_BATCH_SIZE=1
# Local dev (Nomic via Ollama): uncomment below, comment above
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=ollama/nomic-embed-text
# EMBEDDING_DIMENSION=768
# EMBEDDING_MAX_CHARS=32000
# EMBEDDING_MAX_TOKENS=8192
# EMBEDDING_BATCH_SIZE=1

# AWS (used by Bifrost to call Bedrock — not needed if using local Ollama only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Provider API keys (passed to Bifrost gateway, not used by the app directly)
ANTHROPIC_API_KEY=

# Auth
# Generate AUTH_SECRET with: openssl rand -hex 32
AUTH_SECRET=change-me-in-production
AUTH_URL=http://localhost:5172
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# OIDC (optional — Dex for local dev, Okta for production)
# ISSUER_URL is the front-channel URL the browser sees.
# BACKCHANNEL_URL is how the server reaches the IdP directly; only needed
# when the server can't reach ISSUER_URL itself (e.g. docker-compose dev,
# where the compose file overrides this to http://dex:5556/dex). Leave
# unset for public IdPs like Okta.
OIDC_ISSUER_URL=http://localhost:5556/dex
# OIDC_BACKCHANNEL_URL=
OIDC_CLIENT_ID=typhoon
OIDC_CLIENT_SECRET=typhoon-secret

# Role mapping (comma-separated IdP group names per app role)
ADMIN_ROLES=admin
REP_ROLES=rep

# Server
PORT=5172
HOST=0.0.0.0

LOG_LEVEL=info

# OpenTelemetry (optional — docker-compose sets these for you)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=typhoon-api
# OTEL_SERVICE_VERSION=0.0.0
