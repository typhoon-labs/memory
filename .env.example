# =============================================================================
# Typhoon — Environment Variables
# =============================================================================

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://typhoon:typhoon@localhost:5432/typhoon

# Redis
REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=typhoon-documents

# LLM Gateway (OpenAI-compatible endpoint)
LLM_BASE_URL=http://localhost:8787/v1
LLM_API_KEY=changeme
LLM_CHAT_MODEL=anthropic/claude-sonnet-4-6
LLM_TITLE_MODEL=anthropic/claude-haiku-4-5

# Embeddings (OpenAI-compatible endpoint)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# Provider API keys (passed to Bifrost gateway, not used by the app directly)
ANTHROPIC_API_KEY=

# Auth
AUTH_SECRET=change-me-in-production
AUTH_URL=http://localhost:5172
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# OIDC (optional — Dex for local dev, Okta for production)
# OIDC_ISSUER_URL=http://localhost:5556/dex
# OIDC_CLIENT_ID=typhoon
# OIDC_CLIENT_SECRET=typhoon-secret

# Server
PORT=5172
HOST=0.0.0.0
