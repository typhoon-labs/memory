# chain-sts settings for a local run. This file is the list of every variable
# the service reads; the service itself does not read this file. What the
# service decides with is the YAML file CHAIN_STS_CONFIG names
# (config.example.yaml describes every key).

# Required. The configuration file. The image sets /etc/chain-sts/config.yaml.
CHAIN_STS_CONFIG=./config.local.yaml

# Where it listens. The image sets HOST=0.0.0.0 and PORT=8080. The contracts
# give this component no local development port yet.
HOST=127.0.0.1
PORT=8080

APP_VERSION=0.1.0
DEPLOYMENT_ENVIRONMENT=dev
# DEBUG, INFO, WARNING, ERROR or CRITICAL. Every line is JSON, on standard error.
LOG_LEVEL=INFO

# Traces are exported only when the endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=chain-sts
