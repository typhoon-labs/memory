# comms-agent bindings, with the values for a local run. This file is the list of every
# variable the agent reads. scripts/local.sh sets the same defaults.

# Identity. Required. The agent verifies the caller's token against these, then
# forwards that same token to delivery-mcp and to the model endpoint.
OIDC_ISSUER=http://127.0.0.1:18199
OIDC_JWKS_URL=http://127.0.0.1:18199/jwks
OIDC_AUDIENCE=agentgateway

# Required. delivery-mcp's MCP endpoint (Streamable HTTP).
DELIVERY_MCP_URL=http://127.0.0.1:18190/mcp

# Required. The agent posts to <MODEL_BASE_URL>/v1/messages (Anthropic Messages
# API) with "Authorization: Bearer <the caller's token>". It holds no key.
MODEL_BASE_URL=http://localhost:7070
# MODEL_ID is required: it writes the draft. MODEL_ID_FAST is not used.
MODEL_ID=claude-sonnet-5-5
MODEL_ID_FAST=claude-haiku-4-5-20251001
# All the time one model call may take, in seconds. There is no retry. At the
# deadline the agent reports that no draft was written.
MODEL_TIMEOUT_SECONDS=45

# Where it listens. The image sets HOST=0.0.0.0 and PORT=8080.
HOST=127.0.0.1
PORT=18192
# The address in the agent card, as callers reach the agent.
A2A_PUBLIC_URL=http://localhost:18192/

# The limit on a draft, in words. It can be lowered here, not raised above 80.
DRAFT_MAX_WORDS=80

APP_VERSION=0.1.0
DEPLOYMENT_ENVIRONMENT=dev
LOG_LEVEL=INFO

# Traces are exported only when the endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
