{
  "name": "@chat-assistant/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "start": "node --import ./dist/telemetry.js dist/main.js",
    "dev": "tsx --import ./src/telemetry.ts src/main.ts",
    "test": "vitest run",
    "spike": "tsx scripts/spike-mastra-a2a.ts",
    "a2a-client": "tsx scripts/a2a-client.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@ai-sdk/anthropic": "4.0.72",
    "@mastra/core": "1.74.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-undici": "0.32.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "express": "5.2.1",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@a2ui/web_core": "0.12.0",
    "@chat-assistant/ui": "0.1.0",
    "@mastra/express": "1.5.18",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
