# delivery-mcp bindings for a local run. Copy to .env, which is git-ignored.
# The process environment wins over this file. README.md describes every variable.

# Identity. All three are required; the service does not start without them.
# These are the test issuer's (scripts/test_issuer.py).
OIDC_ISSUER=http://127.0.0.1:18199
OIDC_JWKS_URL=http://127.0.0.1:18199/jwks
OIDC_AUDIENCE=agentgateway

# chain-sts, the second issuer: tokens for an agent acting for a user. Optional,
# both or neither; unset, only the issuer above is trusted. The audience is
# OIDC_AUDIENCE. In the dev cluster:
# DELEGATION_ISSUER=http://chain-sts.chain-sts.svc.cluster.local
# DELEGATION_JWKS_URL=http://chain-sts.chain-sts.svc.cluster.local/jwks

# fake keeps the selection in memory; helm upgrades the Sample App release.
APPLIER=fake
RETAINED_VERSIONS=2.0.0

# Optional with the fake applier. When set, the real search request is made.
VERIFY_SEARCH_URL=http://127.0.0.1:18198/search?q=red

# State. :memory: keeps it in memory.
DELIVERY_DB_PATH=:memory:
