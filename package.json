{
  "name": "typhoon",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "bunx biome check .",
    "format": "bunx biome check --write .",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate --filter=@typhoon/db",
    "db:migrate": "turbo run db:migrate --filter=@typhoon/db",
    "db:push": "turbo run db:push --filter=@typhoon/db",
    "seed:docs": "./scripts/seed-documents.sh",
    "setup": "./scripts/dev-setup.sh",
    "reset": "./scripts/reset-dev.sh",
    "clean": "rm -rf node_modules .turbo coverage packages/*/dist packages/*/.turbo apps/*/dist apps/*/.turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "^1.3.11",
    "@vitest/coverage-v8": "^4.1.1",
    "docx": "^9.6.1",
    "mastra": "^1.3.15",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.58.2",
    "turbo": "^2.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1",
    "xlsx": "^0.18.5"
  },
  "packageManager": "bun@1.3.11",
  "overrides": {
    "hono": "4.12.8"
  }
}
