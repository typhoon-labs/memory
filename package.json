{
  "name": "typhoon",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@typhoon/api",
    "dev:desk": "turbo run dev --filter=@typhoon/desk",
    "dev:admin": "turbo run dev --filter=@typhoon/admin",
    "dev:widget": "turbo run dev --filter=@typhoon/widget",
    "dev:worker": "turbo run dev --filter=@typhoon/worker",
    "dev:backend": "turbo run dev --filter=@typhoon/api --filter=@typhoon/worker --filter=@typhoon/scheduler",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "lint": "bunx biome check .",
    "format": "bunx biome check --write .",
    "typecheck": "turbo run typecheck",
    "db:generate": "dotenv -- turbo run db:generate --env-mode=loose --filter=@typhoon/db",
    "db:migrate": "dotenv -- turbo run db:migrate --env-mode=loose --filter=@typhoon/db",
    "db:push": "dotenv -- turbo run db:push --env-mode=loose --filter=@typhoon/db",
    "seed": "./scripts/seed-data.sh",
    "setup": "./scripts/dev-setup.sh",
    "reset": "./scripts/reset-dev.sh",
    "docker:up": "./scripts/docker.sh up -d --build",
    "docker:down": "./scripts/docker.sh down",
    "docker:restart": "./scripts/docker.sh down && ./scripts/docker.sh up -d --build",
    "docker:status": "./scripts/docker.sh ps",
    "docker:build": "./scripts/docker.sh build --no-cache",
    "docker:logs": "./scripts/docker.sh logs -f",
    "doctor": "./scripts/doctor.sh",
    "postinstall": "./scripts/postinstall.sh",
    "clean": "./scripts/clean.sh"
  },
  "devDependencies": {
    "@appsignal/opentelemetry-instrumentation-bullmq": "^0.8.0",
    "@biomejs/biome": "^2.4.4",
    "lefthook": "^1.11.13",
    "@hono/otel": "^1.1.1",
    "@types/bun": "^1.3.11",
    "@vitest/coverage-v8": "^4.1.1",
    "docx": "^9.6.1",
    "dotenv-cli": "^11.0.0",
    "mastra": "^1.3.15",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.58.2",
    "turbo": "^2.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1",
    "xlsx": "^0.18.5"
  },
  "packageManager": "bun@1.3.11",
  "overrides": {
    "hono": "4.12.8"
  },
  "dependencies": {
    "rehype-slug": "^6.0.0"
  }
}
