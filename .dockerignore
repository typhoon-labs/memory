# Dependencies — reinstalled inside the container
node_modules/

# Build outputs — rebuilt inside the container
dist/
out/
*.tsbuildinfo

# Turborepo cache
.turbo/

# Mastra local dev cache
.mastra/

# Git
.git/

# Environment files (secrets passed at runtime, not baked in)
.env
.env.local
.env.*.local

# Test / coverage
coverage/
**/*.test.*
**/*.spec.*
**/__tests__/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Documentation (not needed in image)
docs/
README.md
CLAUDE.md

# Fixtures (test data)
fixtures/

# Lock files we don't use
package-lock.json
yarn.lock
pnpm-lock.yaml

# Playwright
.playwright-mcp/
