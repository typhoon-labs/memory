# The network boundary of namespace `tools` (delivery-mcp, observability-mcp).
# Values for release `tools-network-boundary`, chart
# agent-platform/policies/network/workload-boundary, which explains the rules
# that hold for every workload: in from the gateway only; out to DNS, the
# gateway, Keycloak's keys and the collector only.
#
# A template only to read this kind cluster's addresses; see kind-addresses.sh.
{{- $kind := exec "./kind-addresses.sh" (list) | fromJson }}

servingPorts:
  - 8080   # delivery-mcp: MCP at /mcp
  - 8000   # observability-mcp: MCP at /mcp. Its /healthz is on 8081, for the kubelet only.

# Every entry below is a path that does not go through the gateway. Each is
# there because the design relies on it; the reason is next to it.
exceptions:
  # delivery-mcp is the one workload that changes the cluster. `apply_change`
  # runs `helm upgrade` on release `sample-app` and then checks the search
  # itself (components/delivery-mcp, agent-platform/docs/conventions.md).
  delivery-mcp-applies-changes:
    podLabels:
      app.kubernetes.io/name: delivery-mcp
    egress:
      # 1. The Kubernetes API, to upgrade the release (what it may do there is
      #    its Role, workloads/delivery-mcp/access/), and
      # 2. the registry, for the Sample App chart
      #    (HELM_CHART_REF, oci://agentgateway-demo-registry:5000/charts/sample-app).
      #
      # Neither is a pod, so they are named by address: the node's Docker
      # network, on these two ports only. That is wider than the two
      # containers, on purpose (kind-addresses.sh says why). The network's
      # gateway is left out: it is this machine, where the model endpoint is.
      - to:
          - ipBlock:
              cidr: {{ $kind.nodeNetwork }}
              except:
                - {{ $kind.host }}/32
        ports:
          - protocol: TCP
            port: 6443
          - protocol: TCP
            port: 5000
      # 3. The Sample App's search, to verify a change before it is marked
      #    applied (VERIFY_SEARCH_URL).
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: sample-app
            podSelector:
              matchLabels:
                app.kubernetes.io/name: search-service
        ports:
          - protocol: TCP
            port: 8080

  # observability-mcp answers every tool call by reading Grafana, with its own
  # Viewer credential (workloads/observability-mcp).
  observability-mcp-reads-grafana:
    podLabels:
      app.kubernetes.io/name: observability-mcp
    egress:
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: telemetry
            podSelector:
              matchLabels:
                app.kubernetes.io/name: grafana
        ports:
          - protocol: TCP
            port: 3000
