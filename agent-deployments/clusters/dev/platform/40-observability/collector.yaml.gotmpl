# The one OpenTelemetry Collector of the dev cluster.
#
#   in    OTLP over gRPC   otel-collector.telemetry.svc.cluster.local:4317
#         OTLP over HTTP   http://otel-collector.telemetry.svc.cluster.local:4318
#   out   traces           Tempo, without prompt and completion content
#         traces/langfuse  Langfuse, with that content (only when switched on)
#         logs             Loki
#
# Values for the release `otel-collector` (chart opentelemetry-collector). A
# template: `.Values` is settings.yaml. Metrics do not pass through here;
# Prometheus scrapes them.
#
# The Langfuse pipeline is configured only when it is switched on and its
# Secret exists, so that the collector installs before Langfuse does. The check
# runs kubectl: KUBECONFIG comes from the command line (see Taskfile.yml), and
# naming the context makes it fail on any kubeconfig but ours. The same check
# is in gateway-telemetry.yaml.gotmpl.
{{- $langfuse := false }}
{{- if .Values | get "langfuse.enabled" false }}
{{- $langfuse = ne (exec "kubectl" (list "--context" "kind-agentgateway-demo" "--namespace" .Values.collector.namespace "get" "secret" .Values.langfuse.secret.name "--ignore-not-found" "--output" "name") | trim) "" }}
{{- end }}
mode: deployment
fullnameOverride: {{ .Values.collector.service }}

# The contrib build has the attributes and filter processors.
image:
  repository: otel/opentelemetry-collector-contrib
command:
  name: otelcol-contrib

# The chart's Jaeger and Zipkin ports are not served. `metrics` is the
# collector's own telemetry, scraped through the ServiceMonitor below.
ports:
  jaeger-compact:
    enabled: false
  jaeger-thrift:
    enabled: false
  jaeger-grpc:
    enabled: false
  zipkin:
    enabled: false
  metrics:
    enabled: true
serviceMonitor:
  enabled: true

resources:
  requests:
    cpu: 50m
    memory: 96Mi
  limits:
    memory: 384Mi

{{- if $langfuse }}

# The Authorization header for Langfuse. Optional, so that the pod also starts
# if the Secret is removed later; Langfuse then refuses the spans (401) and the
# other pipelines carry on.
extraEnvs:
  - name: LANGFUSE_AUTHORIZATION
    valueFrom:
      secretKeyRef:
        name: {{ .Values.langfuse.secret.name }}
        key: {{ .Values.langfuse.secret.key }}
        optional: true
{{- end }}

# The whole configuration; the chart's default configuration is not merged in.
alternateConfig:
  extensions:
    health_check:
      endpoint: ${env:MY_POD_IP}:13133

  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: ${env:MY_POD_IP}:4317
        http:
          endpoint: ${env:MY_POD_IP}:4318

  processors:
    memory_limiter:
      check_interval: 5s
      limit_percentage: 80
      spike_limit_percentage: 25
    batch: {}
    # Prompt and completion text does not belong in the operational backend.
    # gen_ai.prompt and gen_ai.completion are what the gateway adds to its
    # model spans (see agent-platform/profiles/gateway/telemetry/). The other three are the content
    # attributes of the OpenTelemetry GenAI conventions, for agents that record
    # content on their own spans.
    attributes/strip-llm-content:
      actions:
        - key: gen_ai.prompt
          action: delete
        - key: gen_ai.completion
          action: delete
        - key: gen_ai.input.messages
          action: delete
        - key: gen_ai.output.messages
          action: delete
        - key: gen_ai.system_instructions
          action: delete
    # Agent Substrate's API server authorizes every call with OpenFGA, which
    # writes a span for each step of each check: about 1,700 of the 1,900 spans
    # of one agent turn, all under one span of the call they belong to. That
    # call's own span stays, so the trace keeps its shape; only what is inside
    # the check goes. Measured on Agent Substrate 0.6.0-alpha3.
    #
    # Since Substrate 1.0 the API server also writes a span for each statement
    # it sends to PostgreSQL (scope atepg). Those of the check, OpenFGA's reads
    # of its own tables and the role a connection it opens takes, hang under
    # the spans dropped above, so each would arrive as a piece of its own:
    # about 400 per agent turn on 1.0.0-rc1. They go too; the statements of the
    # call itself stay.
    filter/substrate-authorization:
      error_mode: ignore
      traces:
        span:
          - resource.attributes["service.name"] == "ateapi" and IsMatch(instrumentation_scope.name, "^(internal/graph/check|openfga/pkg/.*|pkg/storage/sqlcommon)$")
          - resource.attributes["service.name"] == "ateapi" and instrumentation_scope.name == "atepg" and (IsMatch(attributes["db.collection.name"], "^(tuple|store|authorization_model|assertion|changelog)$") or attributes["db.operation.name"] == "SET")
    {{- if $langfuse }}
    # What reaches Langfuse, in two steps.
    #
    # 1. A span that matches is dropped: the services that never take part in
    #    a model call.
    filter/langfuse:
      error_mode: ignore
      traces:
        span:
          - IsMatch(resource.attributes["service.name"], "^({{ join "|" .Values.langfuse.dropServices }})$")
    # 2. Of the rest, whole traces are kept or dropped: a trace is kept when
    #    one of its spans is a model call or an agent's own GenAI span. The
    #    Chat UI's polling of delivery-mcp, several requests a second, has
    #    neither and stays out.
    #
    #    Whole traces, because Langfuse needs a trace's root span to create
    #    it; a span-by-span rule would keep the model call and lose the root.
    #    The price is a delay: spans wait `decision_wait` from the first span
    #    of their trace. A span that arrives after its trace was kept is sent
    #    on at once (sampled cache). A model call slower than the wait still
    #    arrives, as a trace of its own, because dropped traces are not
    #    remembered.
    tail_sampling/langfuse:
      decision_wait: {{ .Values.langfuse.decisionWait }}
      num_traces: 5000
      expected_new_traces_per_sec: 10
      decision_cache:
        sampled_cache_size: 5000
      policies:
        - name: has-model-call
          type: ottl_condition
          ottl_condition:
            error_mode: ignore
            span:
              - attributes["gen_ai.operation.name"] != nil or attributes["gen_ai.request.model"] != nil
    # 3. One model call, one generation. A model call is recorded twice: by
    #    the gateway, which made it, and by the agent that asked for it
    #    (Strands' `chat`, kagent's `generate_content`). Langfuse counted both
    #    as generations, so every trace showed twice its tokens, and twice its
    #    cost. The gateway's span stays the generation: it is the one every
    #    model call has, and the one with the prompt and the completion. The
    #    agent's span stays in the trace as a plain span, without the token
    #    counts. Tempo is not affected: this is the Langfuse pipeline only.
    transform/langfuse:
      error_mode: ignore
      trace_statements:
        - context: span
          statements:
            - set(attributes["langfuse.observation.type"], "span") where resource.attributes["service.name"] != "agentgateway-proxy" and (attributes["gen_ai.request.model"] != nil or attributes["gen_ai.usage.input_tokens"] != nil)
            - delete_matching_keys(attributes, "^gen_ai\\.usage\\.") where resource.attributes["service.name"] != "agentgateway-proxy"
    {{- end }}

    # One set of field names across the audit sources, so that one query by
    # person, session or kind of event finds them all in Loki. The gateway,
    # delivery-mcp and chain-sts write these names themselves (user.id,
    # user.sub, user.client, session.id, token.jti, actor.chain, audit.event,
    # audit.outcome, audit.rule); Keycloak's events and the API server's audit
    # log are given them here, next to their own fields.
    transform/audit:
      error_mode: ignore
      log_statements:
        # A Keycloak event is one line of key="value" pairs that starts with
        # type= (a sign-in, a token) or operationType= (an admin change).
        - context: log
          conditions:
            - resource.attributes["service.name"] == "keycloak" and IsMatch(body, "^(type|operationType)=")
          statements:
            - merge_maps(cache, ParseKeyValue(body, "=", ", "), "upsert")
            - set(attributes["audit.event"], Concat(["keycloak", cache["type"]], ".")) where cache["type"] != nil
            - set(attributes["audit.event"], Concat(["keycloak.admin", cache["operationType"]], ".")) where cache["operationType"] != nil
            - set(attributes["audit.outcome"], "succeeded") where cache["error"] == nil
            - set(attributes["audit.outcome"], "failed") where cache["error"] != nil
            - set(attributes["audit.rule"], cache["error"]) where cache["error"] != nil
            - set(attributes["user.sub"], cache["userId"]) where cache["userId"] != nil
            - set(attributes["user.id"], cache["username"]) where cache["username"] != nil
            - set(attributes["user.client"], cache["clientId"]) where cache["clientId"] != nil
            - set(attributes["session.id"], cache["sessionId"]) where cache["sessionId"] != nil
            - set(attributes["client.address"], cache["ipAddress"]) where cache["ipAddress"] != nil
        # An API server audit event, one JSON object per write
        # (kube-audit-forwarder.yaml). Refused is 401 or 403: not signed in,
        # not allowed by RBAC, or denied by an admission policy. Any other
        # error is a write that failed without being refused, most often 404
        # (already gone) or 409 (already there, or changed meanwhile).
        - context: log
          conditions:
            - resource.attributes["service.name"] == "kube-apiserver-audit"
          statements:
            - set(attributes["user.id"], attributes["user"]["username"])
            - set(attributes["audit.event"], Concat(["kubernetes", attributes["verb"]], "."))
            - set(attributes["audit.outcome"], "allowed") where attributes["responseStatus"]["code"] < 400
            - set(attributes["audit.outcome"], "refused") where attributes["responseStatus"]["code"] == 401 or attributes["responseStatus"]["code"] == 403
            - set(attributes["audit.outcome"], "failed") where attributes["responseStatus"]["code"] >= 400 and attributes["responseStatus"]["code"] != 401 and attributes["responseStatus"]["code"] != 403
            - set(attributes["audit.rule"], attributes["responseStatus"]["message"]) where attributes["responseStatus"]["code"] >= 400

  exporters:
    otlp/tempo:
      endpoint: tempo.telemetry.svc.cluster.local:4317
      tls:
        insecure: true
    otlphttp/loki:
      endpoint: http://loki.telemetry.svc.cluster.local:3100/otlp
    {{- if $langfuse }}
    otlphttp/langfuse:
      endpoint: {{ .Values.langfuse.endpoint }}
      headers:
        Authorization: ${env:LANGFUSE_AUTHORIZATION}
        x-langfuse-ingestion-version: {{ .Values.langfuse.ingestionVersion | quote }}
    {{- end }}

  service:
    extensions:
      - health_check
    telemetry:
      metrics:
        readers:
          - pull:
              exporter:
                prometheus:
                  host: ${env:MY_POD_IP}
                  port: 8888
    pipelines:
      traces:
        receivers: [otlp]
        processors: [memory_limiter, filter/substrate-authorization, attributes/strip-llm-content, batch]
        exporters: [otlp/tempo]
      {{- if $langfuse }}
      traces/langfuse:
        receivers: [otlp]
        processors: [memory_limiter, filter/langfuse, tail_sampling/langfuse, transform/langfuse, batch]
        exporters: [otlphttp/langfuse]
      {{- end }}
      logs:
        receivers: [otlp]
        processors: [memory_limiter, transform/audit, batch]
        exporters: [otlphttp/loki]
