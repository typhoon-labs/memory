# What the dev cluster binds diagnosis-agent to. Values for the chart
# agent-platform/profiles/kagent/agent, merged over the component's own
# components/diagnosis-agent/config/agent.yaml.
#
# A helmfile template, to read the prompt from the component's directory (a
# chart cannot read files outside itself) and to pin the skill image by digest.
{{- $component := "../../../../../components/diagnosis-agent" }}

prompt: {{ readFile (printf "%s/prompts/system.md" $component) | toJson }}

# The image of the component's skills, the runbooks among them
# (components/diagnosis-agent/Dockerfile; `task publish` pushes it). kagent
# takes an image pinned by digest only, so the tag is looked up in the local
# registry each time this file is rendered: a rebuilt image is a new digest, so
# a new revision of the agent. Without the image in the registry the render
# fails, and nothing is applied. The version is the component's
# (DIAGNOSIS_AGENT_SKILLS_VERSION in its Taskfile).
#
# Substrate's node agent pulls it, from agentgateway-demo-registry:5000 and
# not localhost:5002: platform/60-kagent/substrate-values.yaml says why.
# Which skill is in which directory of the image is the component's
# (config/agent.yaml).
skills:
  search-service-runbook:
    source:
      oci: localhost:5002/diagnosis-agent-skills@{{ exec "../../../../../local/registry/digest.sh" (list "diagnosis-agent-skills:0.1.0") | trim }}

model:
  # Not the model route everyone else uses (/v1, a user's token), but this
  # workload's own door to the same backend, opened with the key in the Secret
  # below. Both are created by release `diagnosis-agent-model-access`. How the
  # key works: the header of agent-platform/profiles/kagent/model-access/values.yaml.
  baseUrl: http://agentgateway-proxy.agentgateway-system.svc.cluster.local/workloads/diagnosis-agent/v1
  credential:
    secretName: diagnosis-agent-gateway-key
    secretKey: AGENTGATEWAY_API_KEY

tools:
  kubernetes:
    enabled: true
    # Release `diagnosis-agent-tools`. Reached directly, not through the
    # gateway: it is this agent's own server, it holds no caller identity, and
    # its limits are its flags and its Role.
    url: http://diagnosis-agent-tools.kagent.svc.cluster.local:8084/mcp

  # observability-mcp (Grafana's MCP server behind the gateway): the metrics
  # and traces of the Sample App, for step 4 of the runbook. Three things make
  # this work, and each was a way for it to fail:
  #
  #   1. The route accepts this agent. /mcp/observability asks for a Keycloak
  #      token, and the agent has none to send: it sends a tool a fixed header
  #      from a Secret. (kagent can forward the caller's token with
  #      `tokenPassthrough` since alpha17, and rc1 adds a token its egress
  #      gateway mints per Actor, `actorJwt`; neither is used here.) So the
  #      agent uses a route of its own, opened with its gateway key (release
  #      observability-mcp-workload-access, which names this workload).
  #   2. The address uses the gateway's OTHER DNS name: ending in .svc, not
  #      .svc.cluster.local. Substrate attaches a credential per host name and
  #      header, and the model route already owns `authorization` on the long
  #      name. With the same name for both, the Agent does not compile:
  #      "conflicting credentials for agentgateway-proxy.agentgateway-
  #      system.svc.cluster.local header authorization".
  #   3. Which tools the model is offered is listed in
  #      components/diagnosis-agent/config/agent.yaml.
  observability:
    enabled: true
    url: http://agentgateway-proxy.agentgateway-system.svc/workloads/diagnosis-agent/mcp/observability
    # A Secret key holding the whole header value, "Bearer <the gateway key>":
    # kagent sends it as is, without adding a prefix. mint-key.sh (release
    # diagnosis-agent-model-access) writes it next to the key itself.
    authorization:
      secretName: diagnosis-agent-gateway-key
      secretKey: AUTHORIZATION_HEADER


# Why an image and not git, the other source kagent takes: an Actor fetches a
# git source itself, through the egress gateway, and release
# `substrate-egress-boundary` stops it at the edge of the cluster, as it should.
# An image is pulled by Substrate's node agent, outside the sandbox, from the
# same registry as every other image here, and the agent's egress list does
# not grow. On kagent 1.0.0-alpha7 a git source failed ("Could not resolve
# host: github.com") and an OCI source had to be an HTTPS registry; rc1 mounts
# the image through Substrate's image volumes, which accept this plain HTTP
# registry with the node agent's flag. A skill no longer brings the
# built-in tools: bash, list_files, grep_file and ask_user stay off, and the
# skill adds list_skills, load_skill and load_skill_resource, which only read
# (60-kagent/README.md).
